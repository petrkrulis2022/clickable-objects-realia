{
  "manifest_version": 3,
  "name": "Clickable Objects",
  "version": "0.0.1",
  "description": "Shared clickable objects for online English lessons over Google Meet.",
  "permissions": ["storage"],
  "host_permissions": ["https://meet.google.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["audio/*", "backdrops/*", "packs/*"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}

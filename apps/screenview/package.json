{
  "name": "@screenview/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check:words": "node scripts/check-forbidden-words.mjs",
    "check:isolation": "node scripts/check-interview-isolation.mjs",
    "check": "npm run check:words && npm run check:isolation",
    "build": "npm run check && npm run test && vite build && vite build --config vite.content.config.ts && vite build --config vite.background.config.ts",
    "test": "tsx --test $(find src -name '*.test.ts')",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@overlay/shared": "workspace:*",
    "@screenview/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}

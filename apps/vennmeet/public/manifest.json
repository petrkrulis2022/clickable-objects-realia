{
  "manifest_version": 3,
  "name": "Venn",
  "version": "0.0.1",
  "description": "Three layers over a video call: yours, theirs, and the one you share.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://app.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://app.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://app.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": ["mainWorld.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-layer": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Show or hide the Venn layer"
    }
  }
}
